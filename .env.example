# ==============================================================================
# R3VIVE — Unified Production Environment Variable Reference
# ==============================================================================
# Configure these variables in Vercel (Frontend) and Render (Backend) respectively.
# Do not commit real .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Dashboard)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (Dashboard -> Project Settings -> API -> Project URL)
# Service: Vercel | Public | Required
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon/Publishable Key (Dashboard -> Project Settings -> API -> anon public)
# Service: Vercel | Public | Required
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Backend API URL (Production Render URL or local development server)
# Service: Vercel | Public | Required
VITE_API_URL=https://your-r3vive-backend.onrender.com

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render Dashboard)
# ------------------------------------------------------------------------------
# FastAPI Server Port (Render sets this dynamically via $PORT)
# Service: Render | Configuration | Required (Render sets automatically)
PORT=8000

# Allowed CORS origins for the frontend (comma-separated)
# Service: Render | Configuration | Optional (all *.vercel.app origins are also allowed by regex)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-r3vive-app.vercel.app

# Optional explicit frontend origin
# Service: Render | Configuration | Optional
FRONTEND_URL=https://your-r3vive-app.vercel.app

# Supabase Project URL for server-side token verification and database proxy
# Service: Render | Configuration | Required for cloud persistence
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (for server-side token verification with Supabase Auth)
# Service: Render | Secret | Required for cloud persistence
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase JWT Secret (Dashboard -> Project Settings -> API -> JWT Secret)
# Service: Render | Secret | Optional (used for fast offline HMAC-SHA256 signature verification)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Google Gemini API Key for Generative Decision Intelligence Guidance
# Service: Render | Secret | Optional (deterministic rules engine activates automatically when unconfigured)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model Identifier
# Service: Render | Configuration | Optional (defaults to gemini-2.5-flash)
GEMINI_MODEL_ID=gemini-2.5-flash
