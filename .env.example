# ==============================================================================
# R3VIVE — Unified Environment Variable Reference
# ==============================================================================
# Copy the relevant sections into frontend/.env and backend/.env respectively.
# Do not commit real .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (Dashboard -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon/Publishable Key (Dashboard -> Project Settings -> API -> anon public)
# Safe to expose in the browser client.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Backend FastAPI URL for frontend API calls
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
# FastAPI Server Port
PORT=8000

# Allowed CORS origins for the frontend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Supabase Project URL (same as frontend)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (for server-side token verification with Supabase Auth)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase JWT Secret (Optional: Dashboard -> Project Settings -> API -> JWT Secret)
# Used for fast offline HMAC-SHA256 signature verification of Supabase access tokens.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Google Gemini API Key (Optional: for real-time contextual AI decision guidance)
GEMINI_API_KEY=your-gemini-api-key-here
